# Commonstar reference only. NOT INSTALLED; no server or connection test performed.
# Intended for a dedicated commonstar-inference account on the owner's workstation.
# The account, authorized key and loopback-only model gateway must already be
# deliberately provisioned by the workstation administrator.
# Validate with sshd -t and sshd -T -C user=commonstar-inference,host=localhost,addr=127.0.0.1.
# Preserve an existing administrator session while testing any SSH change.
# Do not replace the global sshd configuration with this fragment.

Match User commonstar-inference
    AuthenticationMethods publickey
    PubkeyAuthentication yes
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    AllowTcpForwarding local
    PermitOpen 127.0.0.1:18081
    AllowStreamLocalForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTTY no
    PermitTunnel no
    PermitUserRC no
    GatewayPorts no
    MaxSessions 0

Match all

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:commonstar:distro-profile:1",
  "title": "Commonstar selected distribution profile",
  "type": "object",
  "required": ["schema_version", "profile_id", "product", "artifact_status", "as_of", "base", "delivery", "installation", "runtime", "updates", "recovery", "release_gate_ids"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "profile_id": {"const": "commonstar-learner-amd64"},
    "product": {"const": "Commonstar Learning OS"},
    "artifact_status": {"enum": ["specification-only", "candidate-built", "release-verified"]},
    "as_of": {"type": "string", "format": "date"},
    "base": {
      "type": "object",
      "required": ["distribution", "major_version", "suite", "architecture", "additional_package_architectures", "desktop", "session", "rolling_suite_aliases_allowed"],
      "properties": {
        "distribution": {"const": "Debian"},
        "major_version": {"const": 13},
        "suite": {"const": "trixie"},
        "architecture": {"const": "amd64"},
        "additional_package_architectures": {"type": "array", "items": {"enum": ["arm64"]}, "uniqueItems": true},
        "session": {"const": "Wayland"},
        "rolling_suite_aliases_allowed": {"const": false}
      }
    },
    "delivery": {
      "type": "object",
      "required": ["default", "builder", "installer", "local_model_bundled", "internet_required_for_bundled_local_learning"],
      "properties": {
        "local_model_bundled": {"const": true},
        "internet_required_for_bundled_local_learning": {"const": false}
      }
    },
    "installation": {
      "type": "object",
      "required": ["partition_table", "firmware", "partitions", "encryption", "swap", "secure_boot", "automatic_existing_disk_conversion"],
      "properties": {
        "partition_table": {"const": "GPT"},
        "firmware": {"const": "UEFI"},
        "automatic_existing_disk_conversion": {"const": false},
        "partitions": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["role", "mount", "filesystem", "encrypted"]}},
        "encryption": {
          "type": "object",
          "required": ["format", "plaintext_unlock_key_in_boot", "hibernation_enabled"],
          "properties": {
            "format": {"const": "LUKS2"},
            "plaintext_unlock_key_in_boot": {"const": false},
            "hibernation_enabled": {"const": false}
          }
        },
        "swap": {
          "type": "object",
          "required": ["default", "disk_swap_default"],
          "properties": {"default": {"const": "zram"}, "disk_swap_default": {"const": false}}
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["mandatory_on_device_inference", "model_database_access", "model_shell_tools", "cloud_default", "unattended_provider_fallback"],
      "properties": {
        "mandatory_on_device_inference": {"const": true},
        "model_database_access": {"const": false},
        "model_shell_tools": {"const": false},
        "cloud_default": {"const": "disabled"},
        "unattended_provider_fallback": {"const": false}
      }
    },
    "updates": {"type": "object", "required": ["mechanism", "channels", "schema_migrations", "automatic_os_snapshot_rollback"]},
    "recovery": {
      "type": "object",
      "required": ["os", "application", "vault", "clean_device_restore_required", "backup_decryption_key_in_cloud"],
      "properties": {"clean_device_restore_required": {"const": true}, "backup_decryption_key_in_cloud": {"const": false}}
    },
    "release_gate_ids": {"type": "array", "minItems": 12, "items": {"type": "string", "pattern": "^REL-[0-9]{2}$"}, "uniqueItems": true}
  },
  "additionalProperties": false
}

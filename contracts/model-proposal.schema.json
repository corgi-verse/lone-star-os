{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:commonstar:schema:model-proposal:1",
  "title": "Commonstar untrusted model proposal",
  "description": "No profile, permission, teacher approval, actor, retention or authoritative score fields are accepted. Local code supplies authority after semantic validation. Proposals use request-scoped labels; the local service resolves them to internal record IDs.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "proposal_id": {
      "$ref": "urn:commonstar:schema:common:1#/$defs/id"
    },
    "kind": {
      "enum": [
        "note.create",
        "fact.propose",
        "preference.propose",
        "learning_state.propose",
        "plan.propose",
        "task.propose",
        "practice.propose",
        "session_summary.propose"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:commonstar:schema:common:1#/$defs/request_evidence_ref"
      },
      "minItems": 0
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "proposal_id",
    "kind",
    "evidence_refs",
    "payload"
  ],
  "additionalProperties": false,
  "$defs": {
    "note.create": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40000
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:commonstar:schema:common:1#/$defs/request_source_ref"
          },
          "minItems": 0
        }
      },
      "required": [
        "title",
        "body",
        "artifact_refs"
      ],
      "additionalProperties": false
    },
    "fact.propose": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "value": {
          "$ref": "urn:commonstar:schema:common:1#/$defs/scalar"
        },
        "data_class": {
          "enum": [
            "learning_context",
            "user_statement"
          ]
        },
        "statement_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:commonstar:schema:common:1#/$defs/request_evidence_ref"
          },
          "minItems": 0
        }
      },
      "required": [
        "key",
        "value",
        "data_class",
        "statement_refs"
      ],
      "additionalProperties": false
    },
    "preference.propose": {
      "type": "object",
      "properties": {
        "key": {
          "enum": [
            "language",
            "text_scale",
            "input_method",
            "reading_preferences",
            "voluntary_interests",
            "notification_preferences"
          ]
        },
        "value": {
          "$ref": "urn:commonstar:schema:common:1#/$defs/scalar"
        },
        "basis": {
          "const": "explicit_user_statement"
        },
        "statement_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:commonstar:schema:common:1#/$defs/request_evidence_ref"
          },
          "minItems": 0
        }
      },
      "required": [
        "key",
        "value",
        "basis",
        "statement_refs"
      ],
      "additionalProperties": false
    },
    "learning_state.propose": {
      "type": "object",
      "properties": {
        "skill_id": {
          "$ref": "urn:commonstar:schema:common:1#/$defs/named_id"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "estimate": {
          "enum": [
            "insufficient_evidence",
            "developing",
            "practicing",
            "ready_for_review"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:commonstar:schema:common:1#/$defs/request_evidence_ref"
          },
          "minItems": 0
        },
        "as_of": {
          "$ref": "urn:commonstar:schema:common:1#/$defs/timestamp"
        }
      },
      "required": [
        "skill_id",
        "summary",
        "estimate",
        "evidence_refs",
        "as_of"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "estimate": {
                "not": {
                  "const": "insufficient_evidence"
                }
              }
            }
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "plan.propose": {
      "type": "object",
      "properties": {
        "goal_ref": {
          "$ref": "urn:commonstar:schema:common:1#/$defs/request_goal_ref"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "resource_refs": {
                "type": "array",
                "items": {
                  "$ref": "urn:commonstar:schema:common:1#/$defs/request_source_ref"
                },
                "minItems": 0
              },
              "due_at": {
                "anyOf": [
                  {
                    "$ref": "urn:commonstar:schema:common:1#/$defs/timestamp"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "estimated_minutes": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "step_ref": {
                "type": "string",
                "pattern": "^step_[1-9][0-9]*$"
              },
              "depends_on_steps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^step_[1-9][0-9]*$"
                },
                "uniqueItems": true
              },
              "depends_on_task_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^T[1-9][0-9]*$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "title",
              "resource_refs",
              "due_at",
              "estimated_minutes",
              "step_ref",
              "depends_on_steps",
              "depends_on_task_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "goal_ref",
        "title",
        "steps",
        "notes",
        "time_zone"
      ],
      "additionalProperties": false
    },
    "task.propose": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "goal_ref": {
          "$ref": "urn:commonstar:schema:common:1#/$defs/request_goal_ref"
        },
        "status": {
          "const": "proposed"
        },
        "due_at": {
          "anyOf": [
            {
              "$ref": "urn:commonstar:schema:common:1#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "time_zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "estimated_minutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:commonstar:schema:common:1#/$defs/request_source_ref"
          },
          "minItems": 0
        },
        "depends_on_task_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^T[1-9][0-9]*$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "title",
        "goal_ref",
        "status",
        "due_at",
        "time_zone",
        "estimated_minutes",
        "resource_refs",
        "depends_on_task_refs"
      ],
      "additionalProperties": false
    },
    "practice.propose": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:commonstar:schema:common:1#/$defs/request_source_ref"
          },
          "minItems": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "response_format": {
          "enum": [
            "short_text",
            "number",
            "multiple_choice",
            "expression"
          ]
        },
        "suggested_answer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_status": {
          "const": "unverified"
        }
      },
      "required": [
        "objective",
        "source_refs",
        "prompt",
        "response_format",
        "suggested_answer",
        "validation_status"
      ],
      "additionalProperties": false
    },
    "session_summary.propose": {
      "type": "object",
      "properties": {
        "goal_ref": {
          "$ref": "urn:commonstar:schema:common:1#/$defs/request_goal_ref"
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "open_steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "minItems": 0
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:commonstar:schema:common:1#/$defs/request_evidence_ref"
          },
          "minItems": 0
        }
      },
      "required": [
        "goal_ref",
        "summary",
        "open_steps",
        "evidence_refs"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "note.create"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/note.create"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "fact.propose"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/fact.propose"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "preference.propose"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/preference.propose"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "learning_state.propose"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/learning_state.propose"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "plan.propose"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/plan.propose"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "task.propose"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/task.propose"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "practice.propose"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/practice.propose"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "session_summary.propose"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/session_summary.propose"
          }
        }
      }
    }
  ]
}

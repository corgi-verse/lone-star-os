{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:commonstar:schema:common:1",
  "title": "Commonstar shared contract types",
  "description": "Closed application contracts. URNs are identifiers, not network resources.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "named_id": {
      "type": "string",
      "pattern": "^urn:commonstar:[a-z][a-z0-9-]*(?::[a-zA-Z0-9][a-zA-Z0-9._-]*)+$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "evidence_ref": {
      "type": "object",
      "properties": {
        "record_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "record_id",
        "revision"
      ],
      "additionalProperties": false
    },
    "source_ref": {
      "type": "object",
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "artifact_id",
        "revision",
        "locator"
      ],
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "unreviewed",
            "observed",
            "model_proposed",
            "user_confirmed",
            "teacher_reviewed",
            "approved",
            "rejected"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reviewer_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "method",
        "reviewer_id"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "teacher_reviewed",
                  "approved"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reviewer_id": {
                "type": "string",
                "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          }
        }
      ]
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ],
      "maxLength": 4000
    },
    "safe_relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "maxLength": 300
    },
    "request_evidence_ref": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[SE][1-9][0-9]*$"
        }
      },
      "required": [
        "ref"
      ],
      "additionalProperties": false
    },
    "request_source_ref": {
      "type": "object",
      "properties": {
        "source_ref": {
          "type": "string",
          "pattern": "^S[1-9][0-9]*$"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "required": [
        "source_ref",
        "locator"
      ],
      "additionalProperties": false
    },
    "request_goal_ref": {
      "enum": [
        "current",
        null
      ]
    }
  }
}
